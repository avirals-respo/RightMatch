# Database Connection URL
# For local SQLite: file:./dev.db
# For production PostgreSQL (Neon, Supabase, Vercel Postgres): postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL="file:./dev.db"

# Session & JWT Authentication Secret (Generate with: openssl rand -base64 32)
JWT_SECRET="replace-with-a-secure-random-secret-in-production"

# Application Environment
NODE_ENV="production"

# Base Application URL
NEXT_PUBLIC_APP_URL="https://your-platform-domain.vercel.app"
